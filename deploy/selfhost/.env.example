# Public hostname of the website (DNS A/AAAA record to this server).
SITE_HOST=transfer.example.com

# Public hostname of the relay (DNS A/AAAA record to this server; may be the
# same server as SITE_HOST). Clients connect to it on TCP 9009-9017.
RELAY_HOST=relay.example.com

# Relay password. Generate one with: openssl rand -hex 24
# Note: croc-web hands this to every browser that opens the site, so it is
# not a secret from anyone who can load the web UI.
CROC_PASS=change-me

# Encrypted temporary storage ("stored mode") limits.
STORE_MAX_TRANSFER=1GiB
STORE_QUOTA=5GiB
STORE_MIN_FREE=512MiB
STORE_MAX_EXPIRATION=2w
STORE_DOWNLOADS=1
